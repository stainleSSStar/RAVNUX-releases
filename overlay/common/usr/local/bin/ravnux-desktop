#!/usr/bin/env bash
set -euo pipefail
wallpaper=/usr/share/backgrounds/ravnux/cyberpunk-city.jpg
marker="$HOME/.config/ravnux/wallpaper-initialized"
[[ ! -f $marker ]] || exit 0
[[ -r $wallpaper ]] || exit 1
# xfdesktop creates monitor-specific properties during startup.
for _ in {1..40}; do
 mapfile -t properties < <(xfconf-query -c xfce4-desktop -l 2>/dev/null | sed -n 's@/last-image$@@p')
 if ((${#properties[@]})); then
  for property in "${properties[@]}"; do
   xfconf-query -c xfce4-desktop -p "$property/last-image" -s "$wallpaper"
   xfconf-query -c xfce4-desktop -p "$property/image-style" -s 5
  done
  mkdir -p "$(dirname "$marker")"
  printf '%s\n' "$wallpaper" > "$marker"
  exit 0
 fi
 sleep 0.5
done
exit 1
